PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/wedplandb
MONGODB_DB_NAME=wedplandb

# Comma-separated client origins allowed by CORS. Include the deployed client
# origin (e.g. https://your-client.vercel.app). Vercel client domains are also
# allowed automatically by the server.
CLIENT_ORIGIN=http://localhost:3000

# Shared with the Next.js client's BETTER_AUTH_SECRET. Sessions created by
# Better Auth are looked up in the same MongoDB database.
JWT_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_SECRET=replace-with-the-same-secret-as-the-client

STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PREMIUM_PRICE_ID=replace-me
